# Copie este arquivo para ".env" e preencha com suas chaves reais.
# O arquivo ".env" (sem "example") já está no .gitignore e não deve ser commitado.

# Chave da OpenAI, usada para transcrição via Whisper API (opcional)
# Se deixar vazio, o script cai automaticamente no Whisper local.
OPENAI_API_KEY=

# Chave da Anthropic, usada para interpretar comandos com Claude (opcional)
# Se deixar vazio, o script cai automaticamente no Ollama local.
ANTHROPIC_API_KEY=
